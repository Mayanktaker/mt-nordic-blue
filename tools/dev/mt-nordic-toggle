#!/usr/bin/env bash
# © Mayanktaker Computers & Web Development | https://mayanktaker.com
# Toggle seamlessly between MT-Nordic-Blue (Dark) and MT-Nordic-Light (Snow Storm)
# Updates GNOME color-scheme, GTK theme, Shell theme, Libadwaita GTK4 CSS, and wallpaper.

set -euo pipefail

THEMES_DIR="${HOME}/.themes"
CONFIG_GTK4="${HOME}/.config/gtk-4.0"

# Register GNOME custom keyboard shortcut (Super+Shift+T)
bind_shortcut() {
  python3 -c "
import subprocess, re, ast

raw = subprocess.check_output(['gsettings', 'get', 'org.gnome.settings-daemon.plugins.media-keys', 'custom-keybindings'], text=True).strip()
if raw.startswith('@as '):
    raw = raw[4:].strip()
current = ast.literal_eval(raw) if raw and raw != '[]' else []

found = False
for path in current:
    try:
        cmd_out = subprocess.check_output(['dconf', 'read', f'{path}command'], text=True).strip()
        if 'mt-nordic-toggle' in cmd_out:
            found = True
            print(f'Shortcut already configured at {path}')
            break
    except Exception:
        pass

if not found:
    idx = 0
    existing_nums = set()
    for path in current:
        m = re.search(r'custom(\d+)/', path)
        if m:
            existing_nums.add(int(m.group(1)))
    while idx in existing_nums:
        idx += 1
    new_path = f'/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom{idx}/'
    subprocess.check_call(['dconf', 'write', f'{new_path}name', \"'MT Nordic Theme Toggle'\"])
    subprocess.check_call(['dconf', 'write', f'{new_path}command', \"'mt-nordic-toggle'\"])
    subprocess.check_call(['dconf', 'write', f'{new_path}binding', \"'<Super><Shift>t'\"])
    current.append(new_path)
    subprocess.check_call(['gsettings', 'set', 'org.gnome.settings-daemon.plugins.media-keys', 'custom-keybindings', str(current)])
    print(f'✨ Successfully bound Super+Shift+T to {new_path}')
"
}

# Unbind GNOME custom keyboard shortcut
unbind_shortcut() {
  python3 -c "
import subprocess, ast

raw = subprocess.check_output(['gsettings', 'get', 'org.gnome.settings-daemon.plugins.media-keys', 'custom-keybindings'], text=True).strip()
if raw.startswith('@as '):
    raw = raw[4:].strip()
current = ast.literal_eval(raw) if raw and raw != '[]' else []

remaining = []
for path in current:
    try:
        cmd_out = subprocess.check_output(['dconf', 'read', f'{path}command'], text=True).strip()
        if 'mt-nordic-toggle' in cmd_out:
            subprocess.check_call(['dconf', 'reset', '-f', path])
            continue
    except Exception:
        pass
    remaining.append(path)

subprocess.check_call(['gsettings', 'set', 'org.gnome.settings-daemon.plugins.media-keys', 'custom-keybindings', str(remaining)])
print('✨ Shortcut removed.')
"
}

# Print current theme status
print_status() {
  current_scheme="$(gsettings get org.gnome.desktop.interface color-scheme | tr -d "'")"
  current_gtk="$(gsettings get org.gnome.desktop.interface gtk-theme | tr -d "'")"
  current_shell="$(dconf read /org/gnome/shell/extensions/user-theme/name 2>/dev/null | tr -d "'" || echo "none")"
  echo "MT Nordic Theme Status:"
  echo "  Color Scheme: ${current_scheme}"
  echo "  GTK Theme:    ${current_gtk}"
  echo "  Shell Theme:  ${current_shell}"
}

# Parse command line flags
ACTION="${1:-toggle}"

case "${ACTION}" in
  --bind-shortcut)
    bind_shortcut
    exit 0
    ;;
  --unbind-shortcut)
    unbind_shortcut
    exit 0
    ;;
  status)
    print_status
    exit 0
    ;;
  -h|--help)
    echo "Usage: mt-nordic-toggle [toggle|dark|light|status|--bind-shortcut|--unbind-shortcut]"
    exit 0
    ;;
esac

CURRENT_SCHEME="$(gsettings get org.gnome.desktop.interface color-scheme | tr -d "'")"

# Determine target theme variant
if [ "${ACTION}" = "light" ] || { [ "${ACTION}" = "toggle" ] && [ "${CURRENT_SCHEME}" = "prefer-dark" ]; }; then
  TARGET="light"
  SCHEME="default"
  THEME_NAME="MT-Nordic-Light"
  echo "Switching to MT Nordic Light (Snow Storm)..."
else
  TARGET="dark"
  SCHEME="prefer-dark"
  THEME_NAME="MT-Nordic-Blue"
  echo "Switching to MT Nordic Blue (Polar Night)..."
fi

# Wallpapers ship only with the dark theme dir; paths mirror install.sh default pairing.
WP_DARK_SRC="${THEMES_DIR}/MT-Nordic-Blue/wallpapers/mt-nordic-blue-art-1-3840x2160.png"
WP_LIGHT_SRC="${THEMES_DIR}/MT-Nordic-Blue/wallpapers/light/mt-nordic-blue-canopy-dawn-3840x2160.png"

# Apply system interface settings
gsettings set org.gnome.desktop.interface color-scheme "${SCHEME}"
gsettings set org.gnome.desktop.interface gtk-theme "${THEME_NAME}"
if [ -d "${THEMES_DIR}/${THEME_NAME}/gnome-shell" ]; then
  dconf write /org/gnome/shell/extensions/user-theme/name "'${THEME_NAME}'" 2>/dev/null || true
fi

# Switch Libadwaita / GTK4 user overrides link
if [ -d "${THEMES_DIR}/${THEME_NAME}/gtk-4.0" ]; then
  mkdir -p "${CONFIG_GTK4}"
  ln -sf "${THEMES_DIR}/${THEME_NAME}/gtk-4.0/gtk.css" "${CONFIG_GTK4}/gtk.css"
  ln -sf "${THEMES_DIR}/${THEME_NAME}/gtk-4.0/gtk-dark.css" "${CONFIG_GTK4}/gtk-dark.css"
fi

# Sync 4K wallpaper pairing like install.sh does: dark art for light mode, light art for dark mode.
if [ -f "${WP_DARK_SRC}" ]; then
  gsettings set org.gnome.desktop.background picture-uri "file://${WP_DARK_SRC}" 2>/dev/null || true
fi
if [ -f "${WP_LIGHT_SRC}" ]; then
  gsettings set org.gnome.desktop.background picture-uri-dark "file://${WP_LIGHT_SRC}" 2>/dev/null || true
fi

# Refresh running apps and compositor styles
nautilus -q 2>/dev/null || true

# Send desktop notification alert if notify-send is available
if command -v notify-send >/dev/null 2>&1; then
  notify-send -u low -i preferences-desktop-theme -a "MT Nordic Theme" "Theme Switched" "Active mode: ${THEME_NAME} (${TARGET}) — reopen apps to finish applying it." 2>/dev/null || true
fi

echo "✨ Switched to ${THEME_NAME} (${TARGET} mode)."
