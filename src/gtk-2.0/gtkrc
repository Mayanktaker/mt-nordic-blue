# MT Nordic Blue — GTK2 legacy application fallback (GIMP 2.10, Audacity, etc.)

gtk-color-scheme = "base_color:#151D2A\nbg_color:#0E141D\ntext_color:#ECEFF4\nfg_color:#ECEFF4\nselected_bg_color:#88C0D0\nselected_fg_color:#090D14\ntooltip_bg_color:#202D40\ntooltip_fg_color:#ECEFF4"

style "default" {
  xthickness = 1
  ythickness = 1

  GtkButton::child-displacement-x = 1
  GtkButton::child-displacement-y = 1
  GtkButton::default-border = { 0, 0, 0, 0 }
  GtkRange::trough-border = 0
  GtkRange::slider-width = 12

  bg[NORMAL]        = "#0E141D"
  bg[ACTIVE]        = "#202D40"
  bg[PRELIGHT]      = "#202D40"
  bg[SELECTED]      = "#88C0D0"
  bg[INSENSITIVE]   = "#090D14"

  base[NORMAL]      = "#151D2A"
  base[ACTIVE]      = "#202D40"
  base[PRELIGHT]    = "#202D40"
  base[SELECTED]    = "#88C0D0"
  base[INSENSITIVE] = "#0E141D"

  fg[NORMAL]        = "#ECEFF4"
  fg[ACTIVE]        = "#ECEFF4"
  fg[PRELIGHT]      = "#ECEFF4"
  fg[SELECTED]      = "#090D14"
  fg[INSENSITIVE]   = "#7B88A1"

  text[NORMAL]      = "#ECEFF4"
  text[ACTIVE]      = "#ECEFF4"
  text[PRELIGHT]    = "#ECEFF4"
  text[SELECTED]    = "#090D14"
  text[INSENSITIVE] = "#7B88A1"
}

style "button" = "default" {
  xthickness = 3
  ythickness = 3
  bg[NORMAL]   = "#151D2A"
  bg[PRELIGHT] = "#202D40"
  bg[ACTIVE]   = "#88C0D0"
  fg[ACTIVE]   = "#090D14"
}

style "entry" = "default" {
  xthickness = 3
  ythickness = 3
  base[NORMAL] = "#151D2A"
}

style "menu" = "default" {
  xthickness = 2
  ythickness = 2
  bg[NORMAL]   = "#151D2A"
  bg[PRELIGHT] = "#88C0D0"
  fg[PRELIGHT] = "#090D14"
}

style "menubar" = "default" {
  bg[NORMAL]   = "#0E141D"
}

style "tooltip" {
  xthickness = 4
  ythickness = 4
  bg[NORMAL]   = "#202D40"
  fg[NORMAL]   = "#ECEFF4"
}

class "GtkWidget" style "default"
class "GtkButton" style "button"
class "GtkEntry" style "entry"
class "GtkMenu" style "menu"
class "GtkMenuBar" style "menubar"
widget "gtk-tooltip*" style "tooltip"
